# Copia para `.env` e ajusta. Estes valores passam-se à app via --dart-define.
# (o .env em si não é lido automaticamente; serve de referência para os comandos)

# URL do servidor PocketBase
PB_URL=http://127.0.0.1:8090

# Locale para números/datas
DEFAULT_LOCALE=pt_PT

# Ativa ecrãs/logs de diagnóstico (true/false)
DEBUG_TOOLS=false
