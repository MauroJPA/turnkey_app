# Copia para pb\.env (fica fora do git) e preenche.
# O serve.ps1 carrega estas variáveis para o ambiente do PocketBase.

# Chave da API da Anthropic — obrigatória para a análise de faturas por IA.
# Obtém-a em https://console.anthropic.com/ -> Settings -> API keys.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# Opcional: modelo a usar (por omissão claude-sonnet-5).
# TURNKEY_AI_MODEL=claude-sonnet-5
