# Segredos e opcoes do servidor gc_turnkey. O `bash gc_turnkey.sh instalar` cria o
# ficheiro `.env` a partir deste e gera a GC_TURNKEY_ENC_KEY. Nunca por no git.
# Valores sem aspas, sem espacos volta do "=".

# --- Cifra dos tokens guardados na app (Vendus, ...) --------------------------
# EXACTAMENTE 32 caracteres. Gerada pelo `gc_turnkey.sh instalar`. Guardar uma copia
# no gestor de palavras-passe, FORA do servidor e dos backups. Nunca mudar depois
# de haver tokens guardados (ficam ilegiveis).
GC_TURNKEY_ENC_KEY=

# --- IA para ler faturas e rotulos ---------------------------------------------
# Chave em https://aistudio.google.com/app/apikey (comeca por AIza).
GC_TURNKEY_AI_PROVIDER=gemini
GEMINI_API_KEY=
# Alternativa: GC_TURNKEY_AI_PROVIDER=anthropic e ANTHROPIC_API_KEY=sk-ant-...
# Modelo principal (por omissao gemini-3.6-flash) e de reserva, separados por virgula, usados quando a
# Google esta sobrecarregada (503) ou retirou um modelo:
# GC_TURNKEY_AI_MODEL=gemini-3.6-flash
# GC_TURNKEY_AI_MODEL_FALLBACK=gemini-3.5-flash,gemini-3.5-flash-lite

# --- Sincronizacao com o Vendus --------------------------------------------------
# O token de cada empresa guarda-se na app (Configuracoes -> Integracoes), cifrado.
# Estas duas so servem de recurso para UMA empresa (id em /_/ -> empresas):
# VENDUS_API_KEY=
# VENDUS_SYNC_EMPRESA=

# --- Alerta por email se o backup falhar (opcional) ----------------------------
# No Gmail usar uma "palavra-passe de aplicacao".
# BACKUP_ALERT_TO=voce@exemplo.pt
# BACKUP_SMTP_HOST=smtp.gmail.com
# BACKUP_SMTP_PORT=587
# BACKUP_SMTP_USER=voce@gmail.com
# BACKUP_SMTP_PASS=

# --- Docker ----------------------------------------------------------------------
# GC_TURNKEY_PORTA=8091        # porta local (127.0.0.1); o gc_turnkey.sh escolhe uma livre
# PB_VERSION=0.40.4        # versao do PocketBase usada ao construir a imagem
